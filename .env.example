# Copy this file to .env and fill in real values before running docker compose up.

# --- Core ---
ENVIRONMENT=development
API_BEARER_TOKEN=dev-local-token

# --- Database (docker-compose overrides this to point at the `db` service) ---
DATABASE_URL=postgresql+psycopg://ceg:ceg@localhost:5433/ceg

# --- Anthropic / Claude (required from Phase 2 onward for claim extraction) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- AssemblyAI (only required for the raw-audio ingestion path, Phase 9) ---
ASSEMBLYAI_API_KEY=

# --- Langfuse (optional; tracing degrades to no-op if unset, Phase 5+) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Mock EHR receiving endpoint (Phase 8) ---
MOCK_EHR_BASE_URL=http://localhost:8000/mock-ehr
